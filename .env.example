# KeywordHunter ortam şablonu
# Yerel çalıştırma: bu dosyayı .env olarak kopyalayın ve ADMIN_PASS'ı GÜÇLÜ bir değerle değiştirin.
# Docker: data/.env otomatik oluşturulur ve ADMIN_PASS boşsa rastgele üretilip loga yazılır.

# --- Kimlik (zorunlu) ---
ADMIN_USER=admin
# Düz metin parola. /settings ekranından parola değiştirildiğinde bu satır silinir
# ve yerine ADMIN_PASS_HASH (bcrypt) yazılır. İsterseniz doğrudan hash da verebilirsiniz:
#   ADMIN_PASS_HASH=$2a$10$...
ADMIN_PASS=change-me-now

# --- Web ---
WEB_ADDR=:8080
# HTTPS ters vekil (nginx/caddy) arkasındaysanız true yapın. Düz HTTP'de true
# yaparsanız tarayıcı çerezi kabul etmez ve giriş döngüye girer.
WEB_SECURE_COOKIES=false
SESSION_TTL_HOURS=24
RATE_LIMIT_RPS=25
RATE_LIMIT_BURST=80

# --- Tor / veri / log ---
# Yerel: Tor Browser 9150, Tor servisi 9050. Docker içinde otomatik tor:9050 olur.
TOR_PROXY=127.0.0.1:9150
DB_PATH=keywordhunter.db
LOG_DIR=logs
LOG_LEVEL=info

# --- İki adımlı doğrulama (2FA / TOTP) ---
# Uygulama ana sırrı: 64 onaltılık karakter (32 bayt). Üretmek için: openssl rand -hex 32
# 2FA sırları bundan türetilen anahtarla AES-256-GCM ile şifreli saklanır. Boş bırakılırsa
# ilk açılışta üretilip bu dosyanın sonuna eklenir (yorumlar korunur). YEDEKLEYİN: kaybolur ya da değişirse kayıtlı
# 2FA sırları çözülemez; kullanıcılar kurtarma kodlarıyla girebilir, aksi halde adminin
# /users ekranından kullanıcıların 2FA kaydını sıfırlaması gerekir.
#APP_SECRET=
# 2FA zorunluluğu: none (varsayılan) | admins (yalnız admin rolü) | all (herkes).
# Kayıtsız kullanıcı yalnız Hesabım'daki 2FA kurulumuna erişir; API token'ları reddedilir.
# admins/all iken users tablosunda olmayan .env yönetici hesabı (ADMIN_USER) giriş yapamaz
# ve kalıcı bir APP_SECRET şarttır (.env yazılamıyorsa uygulama başlamaz).
REQUIRE_2FA=none

# --- Denetim kaydı (audit log) ---
# Hash zincirli denetim olaylarının saklanacağı gün (0 = süresiz). Budamada zincir
# bir çapa ile doğrulanabilir kalır.
AUDIT_RETENTION_DAYS=365

# --- Yedekleme ---
# Zamanlanmış yedeklerin yazılacağı dizin (boş = kapalı). Göreli yol çalışma dizinine göre çözülür.
# Docker: /data/backups (giriş betiği aşağıdaki göreli örneği kalıcı birime, /data/backups'a taşır).
# Yedek VACUUM INTO ile çalışırken alınır, integrity_check ile doğrulanır ve atomik yazılır.
# APP_SECRET yedekte YOKTUR: ayrıca ve yedekten ayrı bir yerde saklayın. Site profili çerezleri ve
# webhook adresleri yedekte açık metindir: yedekleri erişimi kısıtlı ve şifreli saklayın.
#BACKUP_DIR=backups
# Yedek aralığı (saat, 1-8760) ve tutulacak en yeni yedek sayısı (1-1000; eskiler silinir)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# --- Saklama süresi (retention) ---
# Bulguların saklanacağı gün (0 = süresiz); bir aramanın bulguyu SON döndürdüğü andan sayılır, yani
# aramalarda hâlâ çıkan bulgular silinmez. Günde bir, bu süredir görülmeyen bulgular etiket/IOC/graf/ekran
# görüntüleriyle silinir; vaka durumu İnceleniyor (investigating) ya da Doğrulandı (confirmed) olanlar tutulur.
# Silme güvenlidir (secure_delete); daha önce alınmış yedekler BACKUP_KEEP ile döndürülene dek veriyi taşır.
RESULT_RETENTION_DAYS=0
# Ekran görüntülerinin (satır + PNG) saklanacağı gün (0 = süresiz); İnceleniyor/Doğrulandı vakalarının görüntüleri tutulur.
SCREENSHOT_RETENTION_DAYS=0

# --- Prometheus metrikleri ---
# true: GET /metrics açılır (varsayılan false → 404). Uç ASLA anonim değildir: admin rolündeki bir
# hesabın "metrics" kapsamlı API token'ı (yalnız /metrics'i kazır; read/write kabul edilmez)
# "Authorization: Bearer kh_…" ile gönderilmelidir.
# Ayrıntı, metrik listesi ve örnek prometheus.yml: docs/METRICS.md
METRICS_ENABLED=false

# --- İsteğe bağlı ---
# İzleme listesi kontrol aralığı (dakika)
#WATCHLIST_INTERVAL_MIN=15
# Varsayılan izleme listesi tohumu: "none" (boş başla) | "turkey" (gömülü Türk onion listesi) | dosya yolu (JSON)
#WATCHLIST_SEED=none
# Ekran görüntüsü çıktı dizini (Docker: /data/screenshots)
#SCREENSHOT_DIR=screenshots
# Chrome/Chromium yolu (otomatik bulunamazsa)
#CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Kurum içi (10.x / 192.168.x / localhost) webhook alıcılarına izin ver — internete açık kurulumda false
#WEBHOOK_ALLOW_PRIVATE=false
# Tor kontrol portu (NEWNYM / devre yenileme). Tor Browser: 9151, tor servisi: 9051.
# Docker'da tor konteynerine ControlPort açıp HashedControlPassword tanımlamanız gerekir.
#TOR_CONTROL=127.0.0.1:9051
#TOR_CONTROL_PASSWORD=parolaniz
